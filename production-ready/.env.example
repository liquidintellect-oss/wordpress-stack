# ── Environment variables ─────────────────────────────────────────────────────
# Copy this to .env and fill in real values. Never commit .env to git.

# Stack / project name
WP_STACK_NAME=my-wordpress-stack

# Site URL (used to set WP_HOME and WP_SITEURL)
WP_URL=https://example.com

# Host ports (defaults: 80 / 443)
WP_HTTP_PORT=80
WP_HTTPS_PORT=443

# Upload size limits — also update client_max_body_size in nginx/default.conf
WP_MAX_UPLOAD=64M
WP_MAX_FILESIZE=64M

# Database credentials
WP_DB_NAME=wordpress
WP_DB_USER=wordpress
WP_DB_PASSWORD=change_me_strong_password
WP_DB_ROOT_PASSWORD=change_me_root_password

# Optional: override table prefix
WP_TABLE_PREFIX=wp_
