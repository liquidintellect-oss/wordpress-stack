# ── MariaDB performance tuning ───────────────────────────────────────────────
# Place at: ./mysql/my.cnf
#
# innodb_buffer_pool_size is the single most important setting.
# Set it to ~70% of RAM dedicated to the DB container.
# e.g. 2GB container → 1400M

[mysqld]

# InnoDB buffer pool — cache for data and indexes
innodb_buffer_pool_size     = 512M
innodb_buffer_pool_instances = 1      # increase to 2–8 if pool > 1GB

# Redo log — larger = fewer disk writes, better throughput
innodb_log_file_size        = 128M
innodb_log_buffer_size      = 16M

# Flush strategy: 2 = best performance (slight durability trade-off)
# Use 1 (default) if you need strict ACID compliance
innodb_flush_log_at_trx_commit = 2
innodb_flush_method            = O_DIRECT

# Connections
max_connections             = 100
wait_timeout                = 300
interactive_timeout         = 300

# Query cache is deprecated and counter-productive — Redis handles caching
query_cache_type            = 0
query_cache_size            = 0

# Temp tables
tmp_table_size              = 64M
max_heap_table_size         = 64M

# Slow query log — enable temporarily to find slow queries
slow_query_log              = 0
long_query_time             = 2
